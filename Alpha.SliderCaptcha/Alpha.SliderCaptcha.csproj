<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <Description>MVC Slider Captcha</Description>
    <Copyright>Starixsoft</Copyright>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl>https://gitlab.nexdev.net/rome/alpha/alpha.slidercaptcha</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<Deterministic>true</Deterministic>
    <AssemblyVersion>1.0.0.9</AssemblyVersion>
    <FileVersion>1.0.0.9</FileVersion>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mvc captcha</PackageTags>
    <Authors>Starixsoft</Authors>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.0.0.9</Version>
	<EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Caching" Version="2.2.1" />
	<Reference Include="System.Web" />
  </ItemGroup>
</Project>